# Baseline credentials are intentionally weak and exist only in the isolated lab.
BASELINE_DB_ROOT_PASSWORD=password
BASELINE_DB_PASSWORD=app_password

# Replace these values locally; implement_governance_controls.py --apply creates
# a private .env automatically when it is absent.
SECURE_DB_ROOT_PASSWORD=replace_with_generated_secret
SECURE_DB_PASSWORD=replace_with_generated_secret

